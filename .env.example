# production -> slog level error, JSON output
# debug      -> slog level debug, text output
ENV=debug

HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_DEFAULT_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# SQLite file; it is created on the first migrate.
DB_PATH=friend_seek.db
# How long a blocked write waits for the single writer lock.
DB_BUSY_TIMEOUT=5s
DB_MAX_CONNS=4

# How long a published position stays frozen for the seekers. The window is
# measured from the last lookup: a track inside it repeats the previous
# answer, the first one past it publishes the newest row from the table.
GAME_LOCATION_TTL=3m
